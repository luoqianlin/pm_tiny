{
  "schema_version": 1,
  "project": "pm-tiny",
  "platforms": {
    "linux-x86_64": {
      "archive": "tar.gz",
      "architecture": "x86_64",
      "binaries": ["pm_tiny", "pm"],
      "repository_files": [
        "LICENSE",
        "CHANGELOG.md",
        "README.md",
        "README_en.md",
        "examples/config/linux/pm_tiny.yaml",
        "examples/config/linux/prog.yaml",
        "scripts/release/deploy-linux.sh",
        "scripts/release/release_manifest.py"
      ],
      "compatibility": {
        "max_glibc": "2.17",
        "max_glibcxx": "3.4.26",
        "max_cxxabi": "1.3.11"
      }
    },
    "android-arm64-v8a": {
      "archive": "tar.gz",
      "architecture": "arm64-v8a",
      "android_api": 30,
      "ndk_version": "25.1.8937393",
      "binaries": ["pm_tiny", "pm2"],
      "repository_files": [
        "LICENSE",
        "CHANGELOG.md",
        "README.md",
        "README_en.md",
        "examples/config/linux/pm_tiny.yaml",
        "examples/config/linux/prog.yaml"
      ]
    },
    "windows-x64-msvc": {
      "archive": "zip",
      "architecture": "x64",
      "toolchain": "VS 2022/MSVC",
      "binaries": ["pm_tiny.exe", "pm.exe"],
      "repository_files": [
        "LICENSE",
        "CHANGELOG.md",
        "README.md",
        "README_en.md",
        "examples/config/windows/pm_tiny.yaml",
        "examples/config/windows/prog.yaml",
        "scripts/windows/install-service.ps1",
        "scripts/windows/status-service.ps1",
        "scripts/windows/uninstall-service.ps1",
        "scripts/release/deploy-windows.ps1",
        "scripts/release/release_manifest.py"
      ]
    }
  }
}
